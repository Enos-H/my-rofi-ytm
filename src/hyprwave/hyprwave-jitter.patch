diff --git a/visualizer.c b/visualizer.c
index 848a943..f9409d0 100644
--- a/visualizer.c
+++ b/visualizer.c
@@ -2,7 +2,7 @@
 #include <math.h>
 #include <string.h>
 
-#define SMOOTHING_FACTOR 0.7
+#define SMOOTHING_FACTOR 0.85
 
 // Process audio samples into bar heights.
 // Called from PulseAudio thread — writes ONLY to bar_heights[].
@@ -66,7 +66,16 @@ static void pa_stream_read_callback(pa_stream *stream, size_t nbytes, void *user
     const float *samples = (const float *)data;
     size_t n_samples = length / sizeof(float);
 
-    process_audio_samples(state, samples, n_samples);
+    // Accumulate into a ring-window so each RMS pass runs over a larger
+    // sample window (more samples per bin -> lower variance -> less jitter).
+    for (size_t i = 0; i < n_samples; i++) {
+        state->accum_buf[state->accum_len++] = samples[i];
+        if (state->accum_len >= VISUALIZER_ACCUM_SIZE) {
+            process_audio_samples(state, state->accum_buf, state->accum_len);
+            state->accum_len = 0;
+        }
+    }
+
     pa_stream_drop(stream);
 }
 
@@ -93,7 +102,9 @@ static gboolean update_visualizer(gpointer user_data) {
 
         gint bar_height = min_height + (gint)(h * (max_height - min_height));
 
-        gtk_widget_set_size_request(state->bars[i], 3, bar_height);
+        // Width -1: let the bar fill its HBox slot (hexpand distributes the
+        // fixed 275px container evenly) -> packed spectrum like cava.
+        gtk_widget_set_size_request(state->bars[i], -1, bar_height);
 
         // Fade out bars at minimum so there is no flat line when silent
         gtk_widget_set_opacity(state->bars[i], (bar_height <= min_height) ? 0.0 : 1.0);
@@ -142,7 +153,7 @@ static void pa_context_state_callback(pa_context *context, void *userdata) {
 
             pa_buffer_attr buffer_attr = {
                 .maxlength = (uint32_t) -1,
-                .fragsize  = 4096
+                .fragsize  = 8192
             };
 
             // Monitor the default sink — captures playback, not mic
@@ -177,8 +188,11 @@ VisualizerState* visualizer_init() {
         state->bar_smoothed[i] = 0.0;
     }
 
-    // Container: horizontal box, 275px wide, bottom-aligned inside the overlay.
-    GtkWidget *container = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+    // Container: horizontal box, 275px fixed width like vanilla hyprwave,
+    // centered and bottom-aligned inside the control bar overlay. This keeps
+    // the waves inside the dark box with margins on both sides (vanilla look).
+    // Spacing 2 = thin gap between bars like cava.
+    GtkWidget *container = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 2);
     state->container = container;
 
     gtk_widget_set_overflow(container, GTK_OVERFLOW_HIDDEN);
